{
  "name": "dame-pwa",
  "version": "1.12.0",
  "description": "PWA de l'Échiquier Lédenien",
  "type": "module",
  "scripts": {
    "dev": "vite pwa",
    "sync:stockfish": "node scripts/sync-stockfish.cjs",
    "build": "node scripts/sync-stockfish.cjs && npx vite build pwa",
    "type-check": "vue-tsc --project pwa/tsconfig.json",
    "preview": "vite preview pwa",
    "test:unit": "vitest run --config pwa/vite.config.ts",
    "test:unit:watch": "vitest --config pwa/vite.config.ts",
    "test:e2e": "cypress run",
    "lint": "eslint pwa",
    "package": "node scripts/package.cjs",
    "version-sync": "node scripts/version-sync.cjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/vue": "^9.0.8",
    "@ionic/vue-router": "^9.0.8",
    "@tanstack/query-persist-client-core": "^5.104.4",
    "@tanstack/query-sync-storage-persister": "^5.104.4",
    "@tanstack/vue-query": "^5.104.4",
    "@tanstack/vue-table": "^8.21.3",
    "canvas-confetti": "^1.9.4",
    "chessops": "^0.15.1",
    "dame-types": "file:../dame",
    "dompurify": "^3.4.17",
    "eg-chessboard": "file:../eg-chessboard",
    "ionicons": "^8.1.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "roi-types": "file:../roi",
    "simple-jwt-login": "file:../js-sdk",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@wordpress/eslint-plugin": "^25.9.0",
    "adm-zip": "^0.6.1",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "minimatch": "^10.2.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.2",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "stockfish": true,
    "vue-demi@0.14.10": true,
    "fsevents": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "@parcel/watcher@2.6.0": true,
    "cypress@16.1.1": true
  },
  "overrides": {
    "react": "^18.3.1"
  }
}
