{
  "name": "echiquier-ledonien/dame-pwa",
  "description": "PWA de l'Échiquier Lédonien",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
  },
  "scripts": {
    "lint:php": "phpstan analyze --memory-limit=1G",
    "lint": "phpcs",
    "fix": "phpcbf"
 },
  "autoload-dev": {
    "psr-4": {
      "DAME_PWA\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "szepeviktor/phpstan-wordpress": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
